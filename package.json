{
  "name": "interview-atlas",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "desktop": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:install:macos": "npm run desktop:build && bash scripts/install-macos-app.sh",
    "desktop:build:macos": "node scripts/build-desktop.mjs darwin",
    "desktop:build:windows": "node scripts/build-desktop.mjs win32",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:ui": "node scripts/check-browser.mjs",
    "test:flows": "node scripts/check-browser.mjs check-aggregate-blocks check-interview-lifecycle check-background-extraction check-resume-import check-image-sharing check-mock-interview",
    "test:webkit": "node scripts/check-browser.mjs check-cross-browser",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-opener": "2.7.0",
    "lucide-react": "1.49.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
